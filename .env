# توكن البوت (من بوابة مطوري ديسكورد)
DISCORD_TOKEN=هنا_ضع_توكن_البوت_الخاص_بك

# معرف العميل (Client ID)
CLIENT_ID=هنا_ضع_معرف_التطبيق

# معرف السيرفر (اختياري، للتطوير فقط)
GUILD_ID=هنا_ضع_معرف_سيرفرك_للتجربة

# إعدادات قاعدة البيانات PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=titanbot
POSTGRES_USER=postgres
POSTGRES_PASSWORD=كلمة_السر_الخاصة_بقاعدة_البيانات

# رابط الاتصال بقاعدة البيانات (يمكن استخدامه بدلاً من الإعدادات أعلاه)
POSTGRES_URL=postgresql://postgres:كلمة_السر@localhost:5432/titanbot

# إعدادات البيئة
NODE_ENV=production
LOG_LEVEL=warn
PORT=3000
